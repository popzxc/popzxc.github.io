{# Keep Hugo's RSS address. RSS authors require an email address, so use
   Dublin Core's creator field for the public handle instead. -#}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ config.title }}{% if section is defined %} · {{ section.title }}{% endif %}</title>
    <link>{% if section is defined %}{{ section.permalink | escape_xml | safe }}{% else %}{{ config.base_url | escape_xml | safe }}{% endif %}</link>
    <description>{{ config.description }}</description>
    <language>{{ lang }}</language>
    <generator>Zola</generator>
    <atom:link href="{{ feed_url | escape_xml | safe }}" rel="self" type="application/rss+xml"/>
    {% if last_updated is defined %}
      <lastBuildDate>{{ last_updated | date(format="%a, %d %b %Y %H:%M:%S %z") }}</lastBuildDate>
    {% endif %}
    {% for page in pages %}
      <item>
        <title>{{ page.title }}</title>
        <link>{{ page.permalink | escape_xml | safe }}</link>
        <guid isPermaLink="true">{{ page.permalink | escape_xml | safe }}</guid>
        <pubDate>{{ page.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>
        <dc:creator>{{ config.author }}</dc:creator>
        <description xml:base="{{ page.permalink | escape_xml | safe }}">{% if page.summary %}{{ page.summary }}{% else %}{{ page.content }}{% endif %}</description>
      </item>
    {% endfor %}
  </channel>
</rss>
